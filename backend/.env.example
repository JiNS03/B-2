# Google Gemini API 키
# https://aistudio.google.com/apikey 에서 무료로 발급받을 수 있습니다.
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# Firebase 서비스 계정 키 JSON 전체를 "한 줄 문자열"로 붙여넣기
# 예: {"type": "service_account", "project_id": "...", ...}
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 프론트엔드 배포 도메인 (쉼표로 여러 개 가능). 로컬 개발 시에는 "*" 사용 가능
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5500
